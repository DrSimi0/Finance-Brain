# Copia este archivo como .env y rellena tus claves. El archivo .env NO se sube a GitHub.
# Windows (PowerShell):  Copy-Item .env.example .env

# --- Alpaca ---------------------------------------------------------------
# Claves desde https://app.alpaca.markets  (usa primero las de PAPER).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = cuenta paper (recomendado). Cambiar a false solo de forma consciente.
ALPACA_PAPER=true
# Feed de datos históricos: iex (gratis, solo volumen de IEX) o sip (consolidado;
# según tu plan, el histórico sip puede tener 15 min de retraso).
ALPACA_DATA_FEED=iex

# --- Rutas locales ----------------------------------------------------------
FB_DATA_DIR=data
FB_RESULTS_DIR=resultados

# --- Costos por defecto para backtests (fracción, 0.0005 = 5 pb) -------------
FB_FEES=0.0005
FB_SLIPPAGE=0.0005

# --- TradingAgents (opcional, extra [agentes]) ------------------------------
# Proveedor del LLM: openai, anthropic, google, openrouter, ollama, ...
TRADINGAGENTS_LLM_PROVIDER=openai
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_OUTPUT_LANGUAGE=Spanish
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
# Clave del proveedor que elijas (solo la que uses):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
